// to start Prisma GUI do :
// 1) docker exec -it nestjs-backend sh
// 2) npx prisma studio --hostname 0.0.0.0 --port 5555 --browser none
// so go into a browser and open http://localhost:5555

// if prisma is not in sync with the database do: npm prisma db push || npx prisma db push

// to reset the database do npx prisma db push --force-reset, 
// the .dbjournal file that will be created is a safe copy of the db that was 
// deleted and it will be used automatically to restore the db if anything goes wrong

// default accounts
// utente debug, pw debug
// utente test, pw test

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"] //uso con OpenSSL
}

datasource db {
  provider = "sqlite"
  url      = "file:./dbFiles/dev.db"
}

model User {
  id        	Int			@id @default(autoincrement())
  username  	String		@unique // qualsiasi stringa unique puo essere usata come foregn key
  password  	String
  email     	String		@unique
  icon      	String		@default("Mario.png")
  onlineWins	Int			@default(0)
  offlineWins	Int			@default(0)
  isLoggedIn 	Boolean		@default(false)

  socketId  	String?     @unique// campo opzionale per memorizzare l'ID del socket dell'utente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relazione virtuale --> non crea colonna nella tabella
  times RecordTimes[] // relazione con RecordTimes, un utente può avere più record times --> one-to-many
}

model RecordTimes {
  id        	Int			@id @default(autoincrement())
  userName  	String  // userName è la chiave esterna che fa riferimento al nome dell'utente
  time      	Int     // tempo in ms
  trackName     	String  // nome del circuito

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userName], references: [username], onUpdate: Cascade) // relazione con User, ogni record times è associato a un utente
  
  @@unique([userName, trackName]) // un utente può avere un solo record time per ogni circuito
}

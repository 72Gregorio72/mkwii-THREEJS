//   SYSTEM_ALERT
// }

model User {
  id        	Int			@id @default(autoincrement())
  username  	String		@unique // qualsiasi stringa unique puo essere usata come foregn key
  password  	String
  email     	String		@unique
  icon      	String		@default("Mario.png")
  onlineWins	Int			@default(0)
  offlineWins	Int			@default(0)
  isLoggedIn 	Boolean		@default(false)

  socketId  	String?     @unique// campo opzionale per memorizzare l'ID del socket dell'utente
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // relazione virtuale --> non crea colonna nella tabella
  times RecordTimes[] // relazione con RecordTimes, un utente può avere più record times --> one-to-many

  grandPrix GrandPrix[] // relazione con GrandPrix, un utente può partecipare a più gran prix --> one-to-many
  // Amicizie (chi ho aggiunto e chi mi ha aggiunto --> lista completa e' l'unione dei due) --> serve per many-to-many
  friendsInitiated Friendship[] @relation("SentFriendships")
  friendsReceived  Friendship[] @relation("ReceivedFriendships")

  // Richieste di amicizia
  sentRequests     FriendRequest[] @relation("SentRequests")
  receivedRequests FriendRequest[] @relation("ReceivedRequests")

  // Notifiche
  sentNotifications     Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")

  
}

model RecordTimes {
  id        	Int			@id @default(autoincrement())
  userName  	String  // userName è la chiave esterna che fa riferimento al nome dell'utente
  time      	Int     // tempo in ms
  trackName     	String  // nome del circuito

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userName], references: [username], onUpdate: Cascade) // relazione con User, ogni record times è associato a un utente
  
  @@unique([userName, trackName]) // un utente può avere un solo record time per ogni circuito
}

model GrandPrix {
  id        	Int			@id @default(autoincrement())
  userName  	String  // userName è la chiave esterna che fa riferimento al nome dell'utente
  ranking      	Int     // posizione nel gran prix
  grandPrixName     	String  // nome del circuito
  ccs      	Int     @default(40)// cilindrata

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userName], references: [username], onUpdate: Cascade) // relazione con User, ogni record times è associato a un utente
  
  @@unique([userName, grandPrixName, ccs]) // un utente può avere un solo record time per ogni circuito
}


// now only to invite a friend to a room
model Notification {
  id        	Int			@id @default(autoincrement())
  // type        NotificationType
  // isRead      Boolean          @default(false)
  status       String   @default("PENDING") // PENDING, ACCEPTED
  
  // Relazioni
  senderName    String?          // Chi manda l'invito (opzionale per le notifiche di sistema)
  sender      User?            @relation("SentNotifications", fields: [senderName], references: [username], onUpdate: Cascade)
  
  receiverName String           // Chi riceve l'invito
  receiver    User             @relation("ReceivedNotifications", fields: [receiverName], references: [username], onUpdate: Cascade)
  
  // Metadati (molto utile per salvare l'ID della stanza senza creare chiavi esterne rigide)
  entityId    String?          // Qui ci salvi il roomId
  
  createdAt   DateTime         @default(now())
}

// many-to-many
model Friendship {
  id         Int      @id @default(autoincrement())
  
  // Relazione con l'utente che ha iniziato l'amicizia
  user       User     @relation("SentFriendships", fields: [userName], references: [username], onDelete: Cascade)
  userName   String
  
  // Relazione con l'utente che è stato aggiunto
  friend     User     @relation("ReceivedFriendships", fields: [friendName], references: [username], onDelete: Cascade)
  friendName String
  
  createdAt  DateTime @default(now())

  @@unique([userName, friendName]) // Evita doppioni della stessa coppia
}


// quando viene mandata richiesta/notifica si crea nuovo record:
// - se accetta elimino record ed aggiungo friendship
// - se rifiuto elimino il record di friend request
model FriendRequest {
  id           Int      @id @default(autoincrement())
  
  // Chi invia la richiesta
  sender       User     @relation("SentRequests", fields: [senderName], references: [username], onDelete: Cascade)
  senderName   String
  
  // Chi riceve la richiesta
  receiver     User     @relation("ReceivedRequests", fields: [receiverName], references: [username], onDelete: Cascade)
  receiverName String
  
  status       String   @default("PENDING") // PENDING, ACCEPTED
  createdAt    DateTime @default(now())

  @@unique([senderName, receiverName]) // Non puoi mandare due richieste alla stessa persona
}
